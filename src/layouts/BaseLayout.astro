---
import type { Lang } from '../i18n/ui';
import { assetUrl, htmlLang, otherLang, switchLangPath, useTranslations } from '../i18n/utils';
import { getProfile } from '../data/profile';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/components.css';

interface Props {
  lang: Lang;
  /** 完整的 <title>，由各页面自行组合（含页面名与站点名） */
  title: string;
  /** meta description，缺省用 profile 里的定位描述 */
  description?: string;
  /** og:image 路径（相对 public），缺省为示例封面 */
  ogImage?: string;
  /**
   * 语言切换入口是否显示。404 只有一份 `404.html`，切语言会指向不存在的
   * `/en/404/`，所以 404 页传 false。
   */
  showLangSwitch?: boolean;
  /**
   * 规范地址覆盖（含 base 的路径，如 `assetUrl('404.html')`）。
   * 传入时 canonical / og:url 用它，且不再输出 hreflang alternates
   * —— 单语言页面没有可互指的兄弟页面。
   */
  canonicalPath?: string;
}

const {
  lang,
  title,
  description,
  ogImage = 'media/covers/sample-01.svg',
  showLangSwitch = true,
  canonicalPath,
} = Astro.props;
const t = useTranslations(lang);
const p = getProfile(lang);

/** 站点基址由 astro.config.mjs 的 `site` 决定，保证 GH Pages 子路径下也正确 */
const siteBase = Astro.site ?? Astro.url;

/** 当前语言的规范地址（含 base 前缀）；允许页面覆盖 */
const canonicalUrl = canonicalPath
  ? new URL(canonicalPath, siteBase)
  : new URL(switchLangPath(Astro.url, lang), siteBase);
/** 另一语言同页地址 */
const alternateUrl = new URL(switchLangPath(Astro.url, otherLang(lang)), siteBase);
/** x-default 指向默认语言（中文） */
const defaultUrl = new URL(switchLangPath(Astro.url, 'zh'), siteBase);

/** 单语言页面（404）不输出 alternates，避免指向不存在的路由 */
const alternates = canonicalPath
  ? []
  : [
      { hreflang: lang === 'zh' ? 'zh-Hans' : 'en', href: canonicalUrl.href },
      { hreflang: otherLang(lang) === 'zh' ? 'zh-Hans' : 'en', href: alternateUrl.href },
      { hreflang: 'x-default', href: defaultUrl.href },
    ];

const ogImageUrl = new URL(assetUrl(ogImage), siteBase);

const desc = description ?? p.metaDescription;
const faviconHref = assetUrl('favicon.svg');
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl.href} />

    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}

    <link rel="icon" href={faviconHref} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={p.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
  </head>

  <body>
    <a class="skip-link" href="#main">{t('site.skipToContent')}</a>
    <SiteHeader lang={lang} url={Astro.url} showLangSwitch={showLangSwitch} />

    <main class="page" id="main">
      <slot />
    </main>

    <SiteFooter lang={lang} />

    <script is:inline>
      /* ------------------------------------------------------------------
         全站唯一的内联脚本（除 /works 的 React 筛选岛外，页面零模块 JS）
         1. 悬停 / 聚焦即播的静音短视频
         2. 原生 <dialog> lightbox
         两者都尊重 prefers-reduced-motion
         ------------------------------------------------------------------ */
      (function () {
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        /* ---------------- 1. 悬停播放视频 ---------------- */
        function playVideo(video) {
          if (reduceMotion.matches) {
            return;
          }
          var promise = video.play();
          if (promise && typeof promise.catch === 'function') {
            promise.catch(function () {
              /* 浏览器拒绝自动播放时静默降级为 poster 静态图 */
            });
          }
        }

        function pauseVideo(video) {
          video.pause();
          try {
            video.currentTime = 0;
          } catch (error) {
            /* 某些浏览器在元数据未加载时拒绝设置 currentTime，忽略即可 */
          }
        }

        var videos = document.querySelectorAll('video[data-hover-play]');
        Array.prototype.forEach.call(videos, function (video) {
          video.addEventListener('pointerenter', function () {
            playVideo(video);
          });
          video.addEventListener('pointerleave', function () {
            pauseVideo(video);
          });
          video.addEventListener('focusin', function () {
            playVideo(video);
          });
          video.addEventListener('focusout', function () {
            pauseVideo(video);
          });
        });

        /* ---------------- 2. Lightbox ---------------- */
        var dialog = document.querySelector('dialog[data-lightbox]');
        if (!dialog || typeof dialog.showModal !== 'function') {
          return;
        }

        var triggers = Array.prototype.slice.call(
          document.querySelectorAll('[data-lightbox-trigger]')
        );
        if (triggers.length === 0) {
          return;
        }

        var stageImg = dialog.querySelector('[data-lightbox-img]');
        var captionEl = dialog.querySelector('[data-lightbox-caption]');
        var countEl = dialog.querySelector('[data-lightbox-count]');
        var closeBtn = dialog.querySelector('[data-lightbox-close]');
        var prevBtn = dialog.querySelector('[data-lightbox-prev]');
        var nextBtn = dialog.querySelector('[data-lightbox-next]');

        var current = 0;
        var lastTrigger = null;

        function pad(n) {
          return (n < 10 ? '0' : '') + n;
        }

        function render() {
          var trigger = triggers[current];
          if (!trigger || !stageImg) {
            return;
          }
          // 画廊里的媒体由 MediaFrame 渲染，触发按钮是它的子节点：
          // 先按最近的媒体框找图，找不到再退回按钮内部（兼容其它写法）
          var frame = trigger.closest('.media-frame');
          var sourceImg = frame ? frame.querySelector('img') : trigger.querySelector('img');
          var sourceVideo = frame ? frame.querySelector('video') : null;

          if (sourceImg) {
            stageImg.src = sourceImg.currentSrc || sourceImg.src;
            stageImg.alt = sourceImg.alt || '';
          } else if (sourceVideo) {
            stageImg.src = sourceVideo.getAttribute('poster') || '';
            stageImg.alt = sourceVideo.getAttribute('aria-label') || '';
          }
          if (captionEl) {
            captionEl.textContent = trigger.getAttribute('data-caption') || '';
          }
          if (countEl) {
            countEl.textContent = pad(current + 1) + ' / ' + pad(triggers.length);
          }
        }

        function step(delta) {
          current = (current + delta + triggers.length) % triggers.length;
          render();
        }

        Array.prototype.forEach.call(triggers, function (trigger) {
          trigger.addEventListener('click', function () {
            var index = triggers.indexOf(trigger);
            current = index < 0 ? 0 : index;
            lastTrigger = trigger;
            render();
            dialog.showModal();
            if (closeBtn && typeof closeBtn.focus === 'function') {
              closeBtn.focus();
            }
          });
        });

        if (closeBtn) {
          closeBtn.addEventListener('click', function () {
            dialog.close();
          });
        }
        if (prevBtn) {
          prevBtn.addEventListener('click', function () {
            step(-1);
          });
        }
        if (nextBtn) {
          nextBtn.addEventListener('click', function () {
            step(1);
          });
        }

        dialog.addEventListener('keydown', function (event) {
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            step(1);
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            step(-1);
          }
        });

        /* 点击背板（dialog 自身即背板区域）关闭 */
        dialog.addEventListener('click', function (event) {
          if (event.target === dialog) {
            dialog.close();
          }
        });

        /* Esc 由浏览器原生关闭，这里统一把焦点还给触发元素 */
        dialog.addEventListener('close', function () {
          if (lastTrigger && typeof lastTrigger.focus === 'function') {
            lastTrigger.focus();
          }
        });
      })();
    </script>
  </body>
</html>
