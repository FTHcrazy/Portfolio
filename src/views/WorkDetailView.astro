---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { langFromEntryId, localizePath, slugFromEntryId, useTranslations } from '../i18n/utils';
import { getProfile, mailtoHref } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import MediaFrame from '../components/MediaFrame.astro';
import Gallery from '../components/Gallery.astro';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'works'>;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const p = getProfile(lang);

const { Content } = await render(entry);
const data = entry.data;

const pad = (n: number): string => String(n).padStart(2, '0');

/** 同语言作品序列，用于上一个 / 下一个导航 */
const siblings = (
  await getCollection('works', ({ id, data: item }) => langFromEntryId(id) === lang && !item.draft)
).sort((a, b) => a.data.order - b.data.order || b.data.year - a.data.year);

const position = siblings.findIndex((item) => item.id === entry.id);
const safePosition = position < 0 ? 0 : position;
const prev = safePosition > 0 ? siblings[safePosition - 1] : undefined;
const next = safePosition < siblings.length - 1 ? siblings[safePosition + 1] : undefined;
const indexLabel = pad(safePosition + 1);

const worksHref = localizePath('works/', lang);
const workHref = (item: CollectionEntry<'works'>): string =>
  localizePath(`works/${slugFromEntryId(item.id)}/`, lang);

const coverAlt = data.coverAlt || data.title;
const demo = data.demo;
const demoUrl = demo?.url;
const demoVideo = demo?.video;
const demoPoster = demo?.poster ?? data.cover;
const demoNote = demo?.note ?? t('work.demo.availableOnRequest');

const metaStack = data.stack.join(' · ');
const hasMeta = Boolean(data.role || data.duration || data.stack.length > 0 || data.links.length > 0);
---

<BaseLayout
  lang={lang}
  title={`${data.title} — ${p.name}`}
  description={data.summary}
  ogImage={data.cover}
>
  <article>
    <!-- ---------------------------------------------------------------- -->
    <!-- 标题区：编号 / 年份 → display 标题 → tagline → 元数据表            -->
    <!-- ---------------------------------------------------------------- -->
    <header class="wrap work-hero">
      <p class="work-hero__eyebrow meta">
        <a href={worksHref}>{t('work.backToWorks')}</a>
        <span aria-hidden="true">/</span>
        <span>{indexLabel}</span>
        <span aria-hidden="true">/</span>
        <span>{data.year}</span>
      </p>

      <h1 class="display work-hero__title">{data.title}</h1>
      <p class="work-hero__tagline">{data.tagline}</p>

      {hasMeta && (
        <dl class="meta-table">
          {data.role && (
            <div class="meta-table__cell">
              <dt class="meta">{t('work.meta.role')}</dt>
              <dd>{data.role}</dd>
            </div>
          )}
          {data.duration && (
            <div class="meta-table__cell">
              <dt class="meta">{t('work.meta.duration')}</dt>
              <dd>{data.duration}</dd>
            </div>
          )}
          {data.stack.length > 0 && (
            <div class="meta-table__cell">
              <dt class="meta">{t('work.meta.stack')}</dt>
              <dd>{metaStack}</dd>
            </div>
          )}
          {data.links.length > 0 && (
            <div class="meta-table__cell">
              <dt class="meta">{t('work.meta.links')}</dt>
              <dd>
                {data.links.map((link, linkIndex) => (
                  <span>
                    {linkIndex > 0 ? <span aria-hidden="true"> · </span> : null}
                    <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
                  </span>
                ))}
              </dd>
            </div>
          )}
        </dl>
      )}
    </header>

    <!-- 全宽封面 16:9 -->
    <div class="wrap work-cover">
      <MediaFrame poster={data.cover} alt={coverAlt} ratio="16 / 9" priority />
    </div>

    <!-- Markdown 正文 -->
    <section class="wrap section" aria-label={data.title}>
      <div class="prose">
        <Content />
      </div>
    </section>

    <!-- 01 / 功能预览 -->
    {data.gallery.length > 0 && (
      <section class="wrap section" aria-labelledby="preview-heading">
        <SectionHead
          number={t('work.preview.number')}
          title={t('work.preview.title')}
          note={t('work.preview.note')}
          id="preview-heading"
        />
        <Gallery items={data.gallery} lang={lang} />
      </section>
    )}

    <!-- 02 / 现场演示 -->
    <section class="wrap section" aria-labelledby="demo-heading">
      <SectionHead
        number={t('work.demo.number')}
        title={t('work.demo.title')}
        id="demo-heading"
      />

      {demoVideo && (
        <div class="demo-media">
          <MediaFrame poster={demoPoster} video={demoVideo} alt={coverAlt} ratio="16 / 10" />
        </div>
      )}

      {demoUrl ? (
        <div class="demo-live">
          <div class="demo-frame">
            <iframe
              src={demoUrl}
              title={`${t('work.demo.iframeTitle')} — ${data.title}`}
              loading="lazy"
              referrerpolicy="no-referrer"
              allow="fullscreen; clipboard-write"
            ></iframe>
          </div>
          <div class="demo-actions">
            <a class="btn" href={demoUrl} target="_blank" rel="noopener noreferrer">
              {t('work.demo.openNew')}
            </a>
            {demo?.note ? <p class="demo-note">{demo.note}</p> : null}
          </div>
        </div>
      ) : (
        <div class="demo-fallback">
          <div>
            <p><strong>{t('work.demo.unavailable')}</strong></p>
            <p>{demoNote}</p>
          </div>
          <a class="btn btn--ghost" href={mailtoHref(`${data.title} — demo request`)}>
            {t('work.demo.request')}
          </a>
        </div>
      )}
    </section>
  </article>

  <!-- 上一个 / 下一个 -->
  <nav class="wrap work-nav" aria-label={t('work.nav.label')}>
    {prev ? (
      <a class="work-nav__link work-nav__link--prev" href={workHref(prev)}>
        <span class="meta">&larr; {t('work.nav.prev')}</span>
        <span class="work-nav__title">{prev.data.title}</span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}
    {next ? (
      <a class="work-nav__link work-nav__link--next" href={workHref(next)}>
        <span class="meta">{t('work.nav.next')} &rarr;</span>
        <span class="work-nav__title">{next.data.title}</span>
      </a>
    ) : (
      <span aria-hidden="true"></span>
    )}
  </nav>
</BaseLayout>
